generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Desarrollador {
  id                     String     @id @default(cuid())
  nombre                 String
  contacto               String?
  condicionesComerciales String?
  proyectos              Proyecto[]
  createdAt              DateTime   @default(now())
}

model Proyecto {
  id                       String        @id @default(cuid())
  desarrollador            Desarrollador @relation(fields: [desarrolladorId], references: [id])
  desarrolladorId          String
  nombre                   String
  etapaPipeline            String        @default("Vendiendo")
  imagen                   String?
  numeroUnidades           Int
  /// Parámetros de configuración, nunca constantes en el código (spec §12).
  porcentajeAnticipo       Decimal       @default(0.30) @db.Decimal(5, 4)
  porcentajeComision       Decimal       @db.Decimal(5, 4)
  /// Debajo de esto no se financia a 12 meses: se paga de contado (spec §4).
  minimoPlan               Decimal       @default(50000) @db.Decimal(12, 2)
  stripeConnectedAccountId String?
  fechaEntregaUnidades     DateTime?
  prototipos               Prototipo[]
  unidades                 Unidad[]
  createdAt                DateTime      @default(now())
}

model Prototipo {
  id             String          @id @default(cuid())
  proyecto       Proyecto        @relation(fields: [proyectoId], references: [id])
  proyectoId     String
  clave          String
  superficie     Decimal         @db.Decimal(8, 2)
  recamaras      Int
  /// Cuántos climas trae de fábrica: uno por espacio (sala + cada recámara).
  /// Spec §4: vive en el catálogo del prototipo, nunca en el código.
  climasDefault  Int             @default(1)
  precios        Precio[]
  preciosPartida PrecioPartida[]
  unidades       Unidad[]
  createdAt      DateTime        @default(now())

  @@unique([proyectoId, clave])
}

model Paquete {
  id          String    @id @default(cuid())
  nivel       Int       @unique
  slug        String    @unique
  nombre      String
  descripcion String?
  imagen      String?
  /// Los renglones de mercadotecnia que se listan en la tarjeta.
  partidas    String[]
  /// El paquete 05: no trae lista fija, el comprador la arma.
  esArmable   Boolean   @default(false)
  /// Los productos que lo componen, para la ficha de cada uno.
  catalogo    Partida[]
  precios     Precio[]
  planes      Plan[]
  createdAt   DateTime  @default(now())
}

enum FamiliaPartida {
  A_LA_MEDIDA
  DE_CATALOGO
  VALE
}

/// Catálogo de productos. Sustituye al paquete como unidad de venta:
/// spec §4, el plan se arma sobre una lista de partidas con precio.
model Partida {
  id         String          @id @default(cuid())
  clave      String          @unique
  nombre     String
  familia    FamiliaPartida
  /// Se puede escoger en «Arma el tuyo». La cocina no.
  armable    Boolean         @default(true)
  /// Viene marcada de entrada en «Arma el tuyo».
  porDefecto Boolean         @default(false)
  /// Se cotiza por equipo, con contador (los climas).
  porEquipo  Boolean         @default(false)
  /// Su ficha lleva plano: sólo las que se fabrican a la medida.
  llevaPlano Boolean         @default(false)
  imagen     String?
  /// Pares [etiqueta, valor]. Los que dicen «— Moretti» siguen pendientes.
  ficha      Json
  /// Hasta tres opciones de acabado: [nombre, color]. Null si no aplica.
  acabados   Json?
  orden      Int
  paquetes   Paquete[]
  precios    PrecioPartida[]
  renglones  RenglonPlan[]
  createdAt  DateTime        @default(now())
}

/// Precio de lista público de una partida en un prototipo.
/// Ya viene redondeado hacia arriba a la centena (spec §4).
model PrecioPartida {
  id          String    @id @default(cuid())
  prototipo   Prototipo @relation(fields: [prototipoId], references: [id])
  prototipoId String
  partida     Partida   @relation(fields: [partidaId], references: [id])
  partidaId   String
  monto       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@unique([prototipoId, partidaId])
}

/// Versionado: nunca se sobreescribe. Un precio nuevo cierra la vigencia del anterior.
model Precio {
  id           String    @id @default(cuid())
  prototipo    Prototipo @relation(fields: [prototipoId], references: [id])
  prototipoId  String
  paquete      Paquete   @relation(fields: [paqueteId], references: [id])
  paqueteId    String
  monto        Decimal   @db.Decimal(12, 2)
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?
  planes       Plan[]
  createdAt    DateTime  @default(now())

  @@index([prototipoId, paqueteId, vigenteDesde])
}

enum EstadoFinanciero {
  COTIZADO
  APARTADO
  AL_CORRIENTE
  LIQUIDADO
  SUSPENDIDO
  CANCELADO
}

enum EstadoOperativo {
  PENDIENTE
  LEVANTAMIENTO_HECHO
  ACABADOS_ELEGIDOS
  EN_PRODUCCION
  PRODUCIDO
  EN_ALMACEN
}

enum EstadoInstalacion {
  NO_PROGRAMADA
  PROGRAMADA
  INSTALADA
  ENTREGADA
}

model Unidad {
  id                String            @id @default(cuid())
  proyecto          Proyecto          @relation(fields: [proyectoId], references: [id])
  proyectoId        String
  torre             String
  numero            String
  prototipo         Prototipo         @relation(fields: [prototipoId], references: [id])
  prototipoId       String
  estadoFinanciero  EstadoFinanciero  @default(COTIZADO)
  estadoOperativo   EstadoOperativo   @default(PENDIENTE)
  estadoInstalacion EstadoInstalacion @default(NO_PROGRAMADA)
  comprador         Comprador?
  contrato          Contrato?
  createdAt         DateTime          @default(now())

  @@unique([proyectoId, torre, numero])
}

/// R1: sin contrato firmado no se cobra.
model Contrato {
  id            String   @id @default(cuid())
  unidad        Unidad   @relation(fields: [unidadId], references: [id])
  unidadId      String   @unique
  archivoNombre String
  fechaFirma    DateTime
  quienFirmo    String
  createdAt     DateTime @default(now())
}

model Comprador {
  id                    String   @id @default(cuid())
  nombre                String
  contacto              String
  unidad                Unidad   @relation(fields: [unidadId], references: [id])
  unidadId              String   @unique
  folio                 String   @unique
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripeAccountId       String?
  /// «visa terminación 4242». Nunca el número completo.
  tarjetaDescripcion    String?
  /// Lo actualiza el banco por su cuenta (payment_method.automatically_updated).
  tarjetaVenceMes       Int?
  tarjetaVenceAnio      Int?
  /// El banco la reportó perdida, robada o retenida: no se le vuelve a cobrar
  /// hasta que el comprador registre otra.
  tarjetaInvalida       Boolean  @default(false)
  fechaRegistro         DateTime @default(now())
  planes                Plan[]
}

enum EstadoPlan {
  COTIZADO
  ACTIVO
  /// Por exhibiciones vencidas o por una disputa abierta (lib/motor/suspension.ts).
  SUSPENDIDO
  LIQUIDADO
  CANCELADO
}

/// Con qué regla de armado se cotizó el plan (spec §4, S1-03).
enum ModalidadPlan {
  /// Paquete cerrado a su precio de conjunto, más lo agregado a lista.
  PAQUETE
  /// Un paquete cerrado al que se le quitó algo: todo a precio de lista.
  A_LISTA
  /// Canasta desde cero, pieza por pieza a lista, sin cocina.
  ARMA_EL_TUYO
}

model Plan {
  id                 String           @id @default(cuid())
  comprador          Comprador        @relation(fields: [compradorId], references: [id])
  compradorId        String
  /// Etiqueta, no la fuente de verdad: lo vendido son los renglones (spec §4).
  paquete            Paquete          @relation(fields: [paqueteId], references: [id])
  paqueteId          String
  /// El precio de conjunto que se usó. Sólo en modalidad PAQUETE.
  precio             Precio?          @relation(fields: [precioId], references: [id], onDelete: Restrict)
  precioId           String?
  modalidad          ModalidadPlan    @default(PAQUETE)
  version            Int              @default(1)
  /// R2: el precio se congela con el anticipo, no con la cotización.
  /// Null mientras el plan sea todavía una cotización.
  fechaCongelamiento DateTime?
  montoCongelado     Decimal          @db.Decimal(12, 2)
  saldo              Decimal          @db.Decimal(12, 2)
  estado             EstadoPlan       @default(COTIZADO)
  renglones          RenglonPlan[]
  exhibiciones       Exhibicion[]
  pagos              Pago[]
  reembolsos         Reembolso[]
  disputas           Disputa[]
  cargosExcedentes   CargoExcedente[]
  intentosCobro      IntentoCobro[]
  createdAt          DateTime         @default(now())
}

enum OrigenRenglon {
  /// Venía en el paquete cerrado.
  PAQUETE
  /// La agregó el comprador (en «Arma el tuyo», todas).
  AGREGADA
}

/// Lo que se vendió, partida por partida (S1-02). La suma de precioCongelado
/// de los renglones es el montoCongelado del plan, al peso (R7). Al cobrar el
/// anticipo se congela la lista completa, no sólo el total (R2): después no
/// hay ninguna operación del motor que cambie un renglón de precio.
model RenglonPlan {
  id              String           @id @default(cuid())
  plan            Plan             @relation(fields: [planId], references: [id])
  planId          String
  partida         Partida          @relation(fields: [partidaId], references: [id])
  partidaId       String
  cantidad        Int
  /// Precio de lista por pieza al momento de cotizar (copia de PrecioPartida).
  precioLista     Decimal          @db.Decimal(12, 2)
  /// Lo que el renglón suma al plan, cantidad incluida. En un paquete cerrado
  /// es su parte del precio de conjunto (docs/decisiones.md, D-05).
  precioCongelado Decimal          @db.Decimal(12, 2)
  origen          OrigenRenglon
  /// La opción de acabado que eligió el comprador, tal como está en
  /// Partida.acabados («Opción 2 · Nogal»). Cambia hasta el levantamiento (R6).
  acabado         String?
  /// Hasta dos, para la orden de producción (S1-05).
  fotos           FotoReferencia[]
  createdAt       DateTime         @default(now())

  @@unique([planId, partidaId, origen])
}

/// Una foto que sube el comprador para que Moretti vea lo que imagina: el
/// panel que vio en el catálogo, el color exacto. No sustituye al acabado:
/// lo acompaña. El archivo vive detrás de lib/almacenamiento (D-12).
model FotoReferencia {
  id             String      @id @default(cuid())
  renglon        RenglonPlan @relation(fields: [renglonId], references: [id])
  renglonId      String
  /// 1 o 2. Con el índice único, dos subidas simultáneas no dejan tres fotos.
  posicion       Int
  /// Dónde quedó en el almacenamiento. Nunca un nombre que mande el navegador.
  clave          String      @unique
  nombreOriginal String
  /// image/jpeg o image/png, según el contenido del archivo (D-11).
  tipo           String
  bytes          Int
  createdAt      DateTime    @default(now())

  @@unique([renglonId, posicion])
}

enum EstadoExhibicion {
  PENDIENTE
  PAGADA
  VENCIDA
}

model Exhibicion {
  id                   String           @id @default(cuid())
  plan                 Plan             @relation(fields: [planId], references: [id])
  planId               String
  /// 0 = anticipo, 1..12 = mensualidades.
  numero               Int
  fechaProgramada      DateTime
  monto                Decimal          @db.Decimal(12, 2)
  estado               EstadoExhibicion @default(PENDIENTE)
  /// Cuántos cobros rechazó el banco. El siguiente intento es este + 1 y va
  /// en la llave de idempotencia (D-13). Un cobro pendiente no lo sube.
  intentosRechazados   Int              @default(0)
  /// Rechazos con la tarjeta actual; vuelve a 0 cuando el comprador registra
  /// otra. Con esto se decide cuándo dejar de reintentar (lib/motor/reintentos.ts).
  rechazosConTarjeta   Int              @default(0)
  /// Tras un rechazo que se puede reintentar: desde cuándo el barrido vuelve
  /// a cobrarla. Null = desde su fecha programada.
  proximoIntentoEn     DateTime?
  /// El barrido ya no la cobra solo: hace falta otra tarjeta (rechazo que no
  /// se reintenta o se agotaron los reintentos). Se limpia al guardar tarjeta.
  requiereTarjetaNueva Boolean          @default(false)
  /// Un cobro quedó pendiente (el banco lo procesa): el barrido no la toca
  /// hasta que el webhook lo confirme o lo rechace.
  cobroPendienteDesde  DateTime?
  /// El cobro pendiente (en Stripe, el PaymentIntent): con captura manual es
  /// el que se captura o se libera. Se limpia al pagarse o rechazarse.
  referenciaPendiente  String?
  /// Candado del barrido: mientras no pase esta hora, otro barrido no la toma.
  bloqueadaHasta       DateTime?
  /// El código del último rechazo (insufficient_funds, expired_card…), para
  /// saber a qué se debe sin ir a la bitácora. Se limpia al pagarse.
  ultimoCodigoRechazo  String?
  pago                 Pago?
  cargosExcedentes     CargoExcedente[]
  intentosCobro        IntentoCobro[]
  createdAt            DateTime         @default(now())

  @@unique([planId, numero])
  @@index([estado, fechaProgramada])
}

/// R3: un cobro ejecutado no se edita ni se borra.
model Pago {
  id                     String      @id @default(cuid())
  plan                   Plan        @relation(fields: [planId], references: [id])
  planId                 String
  exhibicion             Exhibicion  @relation(fields: [exhibicionId], references: [id])
  exhibicionId           String      @unique
  monto                  Decimal     @db.Decimal(12, 2)
  fecha                  DateTime    @default(now())
  referenciaStripe       String?
  stripePaymentIntentId  String?     @unique
  stripeChargeId         String?
  stripeAccountId        String?
  /// La comisión cobrada en Stripe (application_fee.created, asíncrono en
  /// cargos directos). Referencias como ésta se llenan una vez; los montos no se tocan (R3).
  stripeApplicationFeeId String?     @unique
  /// No se usa para reembolsos ni disputas (R3): esos son registros nuevos.
  estado                 EstadoPago  @default(CONFIRMADO)
  /// Se guarda el porcentaje aplicado, para que un cambio futuro no altere el histórico.
  porcentajeComision     Decimal     @db.Decimal(5, 4)
  montoComision          Decimal     @db.Decimal(12, 2)
  reembolsos             Reembolso[]
  disputas               Disputa[]
  createdAt              DateTime    @default(now())
}

enum OrigenReembolso {
  /// Desde el back office de día uno (reembolsarPago).
  BACK_OFFICE
  /// Moretti lo hizo desde su propio Dashboard; nos enteramos por charge.refunded.
  DASHBOARD_MORETTI
  /// El banco le dio la razón al comprador: Stripe retiró el dinero.
  DISPUTA_PERDIDA
}

/// R3: un reembolso es un movimiento nuevo; el pago original no se edita.
model Reembolso {
  id               String          @id @default(cuid())
  pago             Pago            @relation(fields: [pagoId], references: [id])
  pagoId           String
  plan             Plan            @relation(fields: [planId], references: [id])
  planId           String
  monto            Decimal         @db.Decimal(12, 2)
  origen           OrigenReembolso
  /// re_… del reembolso, o dp_… de la disputa perdida. Único: un webhook repetido no duplica.
  referenciaStripe String          @unique
  /// Si se le devolvió la comisión al comprador (refund_application_fee). Null = no se sabe.
  devolvioComision Boolean?
  motivo           String?
  usuario          String          @default("sistema")
  fecha            DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([planId])
}

enum EstadoDisputa {
  ABIERTA
  GANADA
  PERDIDA
  /// Cerrada sin ganar ni perder (aviso de investigación, aceptada…).
  CERRADA
}

model Disputa {
  id              String        @id @default(cuid())
  pago            Pago          @relation(fields: [pagoId], references: [id])
  pagoId          String
  plan            Plan          @relation(fields: [planId], references: [id])
  planId          String
  stripeDisputeId String        @unique
  monto           Decimal       @db.Decimal(12, 2)
  /// El motivo que da el banco: fraudulent, product_not_received…
  motivo          String
  estado          EstadoDisputa @default(ABIERTA)
  abiertaEn       DateTime      @default(now())
  cerradaEn       DateTime?

  @@index([planId, estado])
}

/// Un cargo confirmado en Stripe para una exhibición que ya estaba pagada.
/// Stripe manda: el dinero entró y queda registrado aquí para devolverlo.
model CargoExcedente {
  id               String     @id @default(cuid())
  exhibicion       Exhibicion @relation(fields: [exhibicionId], references: [id])
  exhibicionId     String
  plan             Plan       @relation(fields: [planId], references: [id])
  planId           String
  referenciaStripe String     @unique
  /// Null si el aviso llegó sin monto (la pasarela falsa, una prueba).
  montoCentavos    Int?
  detectadoEn      DateTime   @default(now())
}

enum EstadoPago {
  CONFIRMADO
  REEMBOLSADO
  DISPUTADO
  AJUSTADO
}

enum EstadoIntentoCobro {
  CREADO
  REQUIERE_ACCION
  PROCESANDO
  CONFIRMADO
  FALLIDO
  CANCELADO
}

/// Un intento existe antes de Pago. Solo un webhook confirmado crea el Pago.
model IntentoCobro {
  id                    String             @id @default(cuid())
  exhibicion            Exhibicion         @relation(fields: [exhibicionId], references: [id])
  exhibicionId          String
  plan                  Plan               @relation(fields: [planId], references: [id])
  planId                String
  idempotencyKey        String             @unique
  stripePaymentIntentId String?            @unique
  stripeAccountId       String
  monto                 Decimal            @db.Decimal(12, 2)
  porcentajeComision    Decimal            @db.Decimal(5, 4)
  montoComision         Decimal            @db.Decimal(12, 2)
  estado                EstadoIntentoCobro @default(CREADO)
  codigoFallo           String?
  mensajeFallo          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([exhibicionId, estado])
  @@index([planId, createdAt])
}

/// Registro durable de eventos Stripe; el ID externo evita reprocesar duplicados.
model EventoStripe {
  id              String    @id @default(cuid())
  stripeEventId   String    @unique
  stripeAccountId String
  tipo            String
  payload         Json
  procesado       Boolean   @default(false)
  procesadoEn     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([stripeAccountId, tipo])
}

/// Bitácora append-only: nunca se edita ni se borra.
model Evento {
  id             String   @id @default(cuid())
  entidadTipo    String
  entidadId      String
  tipo           String
  estadoAnterior String?
  estadoNuevo    String?
  comentario     String?
  usuario        String   @default("sistema")
  fecha          DateTime @default(now())

  @@index([entidadTipo, entidadId])
}
