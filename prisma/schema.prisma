generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Desarrollador {
  id                   String    @id @default(cuid())
  nombre               String
  contacto             String?
  condicionesComerciales String?
  proyectos            Proyecto[]
  createdAt            DateTime  @default(now())
}

model Proyecto {
  id                 String      @id @default(cuid())
  desarrollador      Desarrollador @relation(fields: [desarrolladorId], references: [id])
  desarrolladorId    String
  nombre             String
  etapaPipeline      String      @default("Vendiendo")
  numeroUnidades     Int
  porcentajeAnticipo Decimal     @default(0.10) @db.Decimal(5, 4)
  porcentajeComision Decimal     @db.Decimal(5, 4)
  prototipos         Prototipo[]
  unidades           Unidad[]
  createdAt          DateTime    @default(now())
}

model Prototipo {
  id          String     @id @default(cuid())
  proyecto    Proyecto   @relation(fields: [proyectoId], references: [id])
  proyectoId  String
  clave       String
  superficie  Decimal    @db.Decimal(8, 2)
  recamaras   Int
  precios     Precio[]
  unidades    Unidad[]
  createdAt   DateTime   @default(now())

  @@unique([proyectoId, clave])
}

model Paquete {
  id        String    @id @default(cuid())
  nivel     Int
  nombre    String
  partidas  String[]
  precios   Precio[]
  planes    Plan[]
  createdAt DateTime  @default(now())
}

model Precio {
  id            String     @id @default(cuid())
  prototipo     Prototipo  @relation(fields: [prototipoId], references: [id])
  prototipoId   String
  paquete       Paquete    @relation(fields: [paqueteId], references: [id])
  paqueteId     String
  monto         Decimal    @db.Decimal(12, 2)
  vigenteDesde  DateTime   @default(now())
  vigenteHasta  DateTime?
  planes        Plan[]
  createdAt     DateTime   @default(now())

  @@index([prototipoId, paqueteId, vigenteDesde])
}

enum EstadoFinanciero {
  Cotizado
  Apartado
  Pagando
  Liquidado
  Cancelado
}

enum EstadoOperativo {
  PorMedir
  LevantamientoHecho
  AcabadosElegidos
  EnProduccion
  Producido
  EnAlmacen
}

enum EstadoInstalacion {
  PorProgramar
  Programada
  Instalada
  Entregada
  ConIncidencia
}

model Unidad {
  id                String            @id @default(cuid())
  proyecto          Proyecto          @relation(fields: [proyectoId], references: [id])
  proyectoId        String
  torre             String
  numero            String
  prototipo         Prototipo         @relation(fields: [prototipoId], references: [id])
  prototipoId       String
  estadoFinanciero  EstadoFinanciero  @default(Cotizado)
  estadoOperativo   EstadoOperativo   @default(PorMedir)
  estadoInstalacion EstadoInstalacion @default(PorProgramar)
  comprador         Comprador?
  createdAt         DateTime          @default(now())

  @@unique([proyectoId, torre, numero])
}

model Comprador {
  id            String   @id @default(cuid())
  nombre        String
  contacto      String
  unidad        Unidad   @relation(fields: [unidadId], references: [id])
  unidadId      String   @unique
  fechaRegistro DateTime @default(now())
  planes        Plan[]
}

enum EstadoPlan {
  Activo
  Liquidado
  Cancelado
}

model Plan {
  id           String        @id @default(cuid())
  comprador    Comprador     @relation(fields: [compradorId], references: [id])
  compradorId  String
  paquete      Paquete       @relation(fields: [paqueteId], references: [id])
  paqueteId    String
  precio       Precio        @relation(fields: [precioId], references: [id])
  precioId     String
  version      Int           @default(1)
  saldo        Decimal       @db.Decimal(12, 2)
  estado       EstadoPlan    @default(Activo)
  exhibiciones Exhibicion[]
  createdAt    DateTime      @default(now())
}

enum EstadoExhibicion {
  Pendiente
  Pagada
  Vencida
}

model Exhibicion {
  id               String           @id @default(cuid())
  plan             Plan             @relation(fields: [planId], references: [id])
  planId           String
  numero           Int
  fechaProgramada  DateTime
  monto            Decimal          @db.Decimal(12, 2)
  estado           EstadoExhibicion @default(Pendiente)
  fechaPagada      DateTime?
  createdAt        DateTime         @default(now())

  @@unique([planId, numero])
}

model Evento {
  id             String   @id @default(cuid())
  entidadTipo    String
  entidadId      String
  tipo           String
  estadoAnterior String?
  estadoNuevo    String?
  comentario     String?
  fecha          DateTime @default(now())
}
