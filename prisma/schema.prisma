generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Desarrollador {
  id                     String     @id @default(cuid())
  nombre                 String
  contacto               String?
  condicionesComerciales String?
  proyectos              Proyecto[]
  createdAt              DateTime   @default(now())
}

model Proyecto {
  id                       String        @id @default(cuid())
  desarrollador            Desarrollador @relation(fields: [desarrolladorId], references: [id])
  desarrolladorId          String
  nombre                   String
  etapaPipeline            String        @default("Vendiendo")
  imagen                   String?
  numeroUnidades           Int
  /// Parámetros de configuración, nunca constantes en el código (spec §12).
  porcentajeAnticipo       Decimal       @default(0.30) @db.Decimal(5, 4)
  porcentajeComision       Decimal       @db.Decimal(5, 4)
  minimoPlan               Decimal       @default(50000) @db.Decimal(12, 2)
  stripeConnectedAccountId String?
  fechaEntregaUnidades     DateTime?
  prototipos               Prototipo[]
  unidades                 Unidad[]
  createdAt                DateTime      @default(now())
}

model Prototipo {
  id         String   @id @default(cuid())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  proyectoId String
  clave      String
  superficie Decimal  @db.Decimal(8, 2)
  recamaras  Int
  precios    Precio[]
  unidades   Unidad[]
  createdAt  DateTime @default(now())

  @@unique([proyectoId, clave])
}

model Paquete {
  id          String   @id @default(cuid())
  nivel       Int      @unique
  nombre      String
  descripcion String?
  imagen      String?
  partidas    String[]
  precios     Precio[]
  planes      Plan[]
  createdAt   DateTime @default(now())
}

/// Versionado: nunca se sobreescribe. Un precio nuevo cierra la vigencia del anterior.
model Precio {
  id           String    @id @default(cuid())
  prototipo    Prototipo @relation(fields: [prototipoId], references: [id])
  prototipoId  String
  paquete      Paquete   @relation(fields: [paqueteId], references: [id])
  paqueteId    String
  monto        Decimal   @db.Decimal(12, 2)
  vigenteDesde DateTime  @default(now())
  vigenteHasta DateTime?
  planes       Plan[]
  createdAt    DateTime  @default(now())

  @@index([prototipoId, paqueteId, vigenteDesde])
}

enum EstadoFinanciero {
  COTIZADO
  APARTADO
  AL_CORRIENTE
  LIQUIDADO
  SUSPENDIDO
  CANCELADO
}

enum EstadoOperativo {
  PENDIENTE
  LEVANTAMIENTO_HECHO
  ACABADOS_ELEGIDOS
  EN_PRODUCCION
  PRODUCIDO
  EN_ALMACEN
}

enum EstadoInstalacion {
  NO_PROGRAMADA
  PROGRAMADA
  INSTALADA
  ENTREGADA
}

model Unidad {
  id                String            @id @default(cuid())
  proyecto          Proyecto          @relation(fields: [proyectoId], references: [id])
  proyectoId        String
  torre             String
  numero            String
  prototipo         Prototipo         @relation(fields: [prototipoId], references: [id])
  prototipoId       String
  estadoFinanciero  EstadoFinanciero  @default(COTIZADO)
  estadoOperativo   EstadoOperativo   @default(PENDIENTE)
  estadoInstalacion EstadoInstalacion @default(NO_PROGRAMADA)
  comprador         Comprador?
  contrato          Contrato?
  createdAt         DateTime          @default(now())

  @@unique([proyectoId, torre, numero])
}

/// R1: sin contrato firmado no se cobra.
model Contrato {
  id            String   @id @default(cuid())
  unidad        Unidad   @relation(fields: [unidadId], references: [id])
  unidadId      String   @unique
  archivoNombre String
  fechaFirma    DateTime
  quienFirmo    String
  createdAt     DateTime @default(now())
}

model Comprador {
  id                    String   @id @default(cuid())
  nombre                String
  contacto              String
  unidad                Unidad   @relation(fields: [unidadId], references: [id])
  unidadId              String   @unique
  folio                 String   @unique
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripeAccountId       String?
  fechaRegistro         DateTime @default(now())
  planes                Plan[]
}

enum EstadoPlan {
  COTIZADO
  ACTIVO
  LIQUIDADO
  CANCELADO
}

enum EstadoPago {
  CONFIRMADO
  REEMBOLSADO
  DISPUTADO
  AJUSTADO
}

enum EstadoIntentoCobro {
  CREADO
  REQUIERE_ACCION
  PROCESANDO
  CONFIRMADO
  FALLIDO
  CANCELADO
}

model Plan {
  id                 String         @id @default(cuid())
  comprador          Comprador      @relation(fields: [compradorId], references: [id])
  compradorId        String
  paquete            Paquete        @relation(fields: [paqueteId], references: [id])
  paqueteId          String
  precio             Precio         @relation(fields: [precioId], references: [id])
  precioId           String
  version            Int            @default(1)
  /// R2: el precio se congela con el anticipo, no con la cotización.
  /// Null mientras el plan sea todavía una cotización.
  fechaCongelamiento DateTime?
  montoCongelado     Decimal        @db.Decimal(12, 2)
  saldo              Decimal        @db.Decimal(12, 2)
  estado             EstadoPlan     @default(COTIZADO)
  exhibiciones       Exhibicion[]
  pagos              Pago[]
  intentosCobro      IntentoCobro[]
  createdAt          DateTime       @default(now())
}

enum EstadoExhibicion {
  PENDIENTE
  PAGADA
  VENCIDA
}

model Exhibicion {
  id              String           @id @default(cuid())
  plan            Plan             @relation(fields: [planId], references: [id])
  planId          String
  /// 0 = anticipo, 1..12 = mensualidades.
  numero          Int
  fechaProgramada DateTime
  monto           Decimal          @db.Decimal(12, 2)
  estado          EstadoExhibicion @default(PENDIENTE)
  pago            Pago?
  intentosCobro   IntentoCobro[]
  createdAt       DateTime         @default(now())

  @@unique([planId, numero])
}

/// R3: un cobro ejecutado no se edita ni se borra.
model Pago {
  id                    String     @id @default(cuid())
  plan                  Plan       @relation(fields: [planId], references: [id])
  planId                String
  exhibicion            Exhibicion @relation(fields: [exhibicionId], references: [id])
  exhibicionId          String     @unique
  monto                 Decimal    @db.Decimal(12, 2)
  fecha                 DateTime   @default(now())
  referenciaStripe      String?
  stripePaymentIntentId String?    @unique
  stripeChargeId        String?
  stripeAccountId       String?
  estado                EstadoPago @default(CONFIRMADO)
  /// Se guarda el porcentaje aplicado, para que un cambio futuro no altere el histórico.
  porcentajeComision    Decimal    @db.Decimal(5, 4)
  montoComision         Decimal    @db.Decimal(12, 2)
  createdAt             DateTime   @default(now())
}

/// Un intento existe antes de Pago. Solo un webhook confirmado crea el Pago.
model IntentoCobro {
  id                    String             @id @default(cuid())
  exhibicion            Exhibicion         @relation(fields: [exhibicionId], references: [id])
  exhibicionId          String
  plan                  Plan               @relation(fields: [planId], references: [id])
  planId                String
  idempotencyKey        String             @unique
  stripePaymentIntentId String?            @unique
  stripeAccountId       String
  monto                 Decimal            @db.Decimal(12, 2)
  porcentajeComision    Decimal            @db.Decimal(5, 4)
  montoComision         Decimal            @db.Decimal(12, 2)
  estado                EstadoIntentoCobro @default(CREADO)
  codigoFallo           String?
  mensajeFallo          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([exhibicionId, estado])
  @@index([planId, createdAt])
}

/// Registro durable de eventos Stripe; el ID externo evita reprocesar duplicados.
model EventoStripe {
  id              String    @id @default(cuid())
  stripeEventId   String    @unique
  stripeAccountId String
  tipo            String
  payload         Json
  procesado       Boolean   @default(false)
  procesadoEn     DateTime?
  error           String?
  createdAt       DateTime  @default(now())

  @@index([stripeAccountId, tipo])
}

/// Bitácora append-only: nunca se edita ni se borra.
model Evento {
  id             String   @id @default(cuid())
  entidadTipo    String
  entidadId      String
  tipo           String
  estadoAnterior String?
  estadoNuevo    String?
  comentario     String?
  usuario        String   @default("sistema")
  fecha          DateTime @default(now())

  @@index([entidadTipo, entidadId])
}
