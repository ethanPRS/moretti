# Copia este archivo a .env y ajusta el usuario de tu Postgres local.
# Nunca pongas aquí llaves reales: este archivo sí va al repositorio.

DATABASE_URL="postgresql://TU_USUARIO@localhost:5432/moretti_dev?schema=public"

# Opcional. Las pruebas de integración usan una base aparte; si no la pones,
# se deriva de DATABASE_URL (moretti_dev → moretti_pruebas). Tiene que
# terminar en _pruebas o _test: las pruebas la vacían.
# DATABASE_URL_PRUEBAS="postgresql://TU_USUARIO@localhost:5432/moretti_pruebas?schema=public"

# Opcional. Dónde se guardan las fotos de referencia (por defecto ./almacen).
# ALMACEN_LOCAL_DIR="./almacen"

# Stripe (Charly, S1-06 a S1-10). Usa exclusivamente valores de prueba.
# La llave NEXT_PUBLIC_ se expone al navegador; las otras dos son sólo de servidor.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Sólo si en el Dashboard registras aparte el endpoint de las cuentas conectadas
# (Connect): su firma es otra. Con `stripe listen` local basta la de arriba.
# STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."
# Sólo para `npm run test:stripe`: la cuenta conectada de prueba de Moretti.
# STRIPE_E2E_CUENTA="acct_..."

# Barrido de la cobranza (docs/integracion-stripe.md). El cron llama
# /api/cobranza/barrido con «Authorization: Bearer <CRON_SECRET>».
# Genera con: openssl rand -hex 32
# CRON_SECRET="..."
# Exhibiciones vencidas que suspenden el plan (lo fija el contrato; por defecto 2).
# COBRANZA_VENCIDAS_SUSPENDEN="2"
# Captura del anticipo: automatic (por defecto) o manual. Decisión legal pendiente.
# STRIPE_CAPTURE_METHOD="automatic"

# Acceso al back office. Nunca la contraseña en claro: su hash scrypt.
# Genera con: node scripts/hash-contrasena.mjs 'tu-contraseña'
ADMIN_PASSWORD_HASH="scrypt:..."
# Firma las sesiones. Mínimo 32 caracteres. Genera con: openssl rand -hex 32
SESSION_SECRET="genera_un_secreto_largo_y_aleatorio"
